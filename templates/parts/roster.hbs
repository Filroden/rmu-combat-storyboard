<div class="rmu-combat-storyboard-main rmu-combat-storyboard-window-scrollable {{#if (eq state.activeTab 'roster')}}active{{/if}}" data-tab="roster" data-group="primary">

    <fieldset class="rmu-combat-storyboard-fieldset">
        <legend>{{localize "RMU_STORYBOARD.Wizard.Labels.CampaignContext"}}</legend>
        <div class="form-group stacked">
            <label>{{localize "RMU_STORYBOARD.Wizard.Labels.Atmosphere"}}</label>
            <textarea name="campaignContext" rows="4" placeholder="{{localize 'RMU_STORYBOARD.Wizard.Placeholders.CampaignContext'}}">{{state.campaignContext}}</textarea>
            <p class="notes">{{localize "RMU_STORYBOARD.Wizard.Hints.CampaignContext"}}</p>
        </div>
    </fieldset>

    <fieldset class="rmu-combat-storyboard-fieldset">
        <legend>{{localize "RMU_STORYBOARD.Wizard.Labels.Roster"}}</legend>
    
        <p class="notes">{{localize "RMU_STORYBOARD.Wizard.Hints.Roster"}}</p>

        {{#each state.roster as |actor|}}
            <fieldset class="rmu-combat-storyboard-fieldset">
                <legend>{{actor.name}}</legend>
                <div class="form-group stacked">
                    <textarea name="roster.{{actor.id}}" rows="2">{{actor.descriptor}}</textarea>
                </div>
            </fieldset>
        {{else}}
            <div class="rmu-combat-storyboard-empty">
                <p>{{localize "RMU_STORYBOARD.Wizard.Empty.Roster"}}</p>
            </div>
        {{/each}}

    </fieldset>

</div>